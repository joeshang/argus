{
  "version": 5,
  "cmakeMinimumRequired": {"major": 3, "minor": 24, "patch": 0},
  "configurePresets": [
    {"name": "debug", "generator": "Unix Makefiles", "binaryDir": "${sourceDir}/.build/debug", "cacheVariables": {"CMAKE_BUILD_TYPE": "Debug", "BUILD_TESTING": "ON"}},
    {"name": "release", "inherits": "debug", "binaryDir": "${sourceDir}/.build/release", "cacheVariables": {"CMAKE_BUILD_TYPE": "Release", "BUILD_TESTING": "OFF"}},
    {"name": "ubsan", "inherits": "debug", "binaryDir": "${sourceDir}/.build/ubsan", "cacheVariables": {"ARGUS_SANITIZER": "undefined"}}
  ],
  "buildPresets": [
    {"name": "debug", "configurePreset": "debug"},
    {"name": "release", "configurePreset": "release"},
    {"name": "ubsan", "configurePreset": "ubsan"}
  ],
  "testPresets": [
    {"name": "debug", "configurePreset": "debug", "output": {"outputOnFailure": true}},
    {"name": "ubsan", "configurePreset": "ubsan", "output": {"outputOnFailure": true}}
  ]
}
